FROM mcr.microsoft.com/playwright:v1.61.1-noble AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

FROM base AS deps
# Provide dummy URI so prisma generate (in postinstall) doesn't crash during build
ARG MONGODB_URI="mongodb://dummy"
COPY package.json pnpm-lock.yaml prisma.config.ts ./
COPY prisma ./prisma
RUN pnpm install --frozen-lockfile

FROM base AS test
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Provide dummy URI again for the manual generate step during build
ARG MONGODB_URI="mongodb://dummy"
RUN pnpm prisma generate

ENV E2E_FULL=1
CMD ["sh", "-c", "pnpm db:push && pnpm exec playwright test"]