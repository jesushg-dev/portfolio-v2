# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# When adding additional environment variables, the schema in "/src/env.ts"
# should be updated accordingly.

# ----------------------------------------------------------------------------
# Database (MongoDB)
# ----------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/portfolio"

# ----------------------------------------------------------------------------
# Better Auth
# Generate a secret with: `openssl rand -base64 32`
# ----------------------------------------------------------------------------
BETTER_AUTH_SECRET=""
# Optional: Set explicit base URL when not using the request's host
# BETTER_AUTH_URL="http://lvh.me:3000"

# System email delivery (password reset, verification — not portfolio contact/CV)
RESEND_API_KEY=""
RESEND_EMAIL_DOMAIN="yourdomain.com"
# Template IDs for auth emails only (run `cd email-templates && npm run publish:resend`)
# RESEND_TEMPLATE_RESET_EN=""
# RESEND_TEMPLATE_RESET_ES=""
# RESEND_TEMPLATE_RESET_NL=""
# RESEND_TEMPLATE_TWO_FACTOR_EN=""
# RESEND_TEMPLATE_TWO_FACTOR_ES=""
# RESEND_TEMPLATE_TWO_FACTOR_NL=""

# Seed + Playwright owner (never use production passwords in Preview)
# OWNER_USER_EMAIL=""
# OWNER_USER_PASSWORD=""

# Portfolio emails (CV delivery, contact form) are configured per tenant in
# Admin → Credentials → Resend — not via these env vars.
# Full split (system vs tenant APIs): docs/tenant-credentials.md

# ----------------------------------------------------------------------------
# OAuth (optional, only fill if you want social login)
# Job Tracker Google Calendar sync is BYO under Admin → Credentials —
# do not reuse these login client credentials for Calendar.
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ----------------------------------------------------------------------------
# Multi-tenant configuration
# In production: your apex domain (jesushg.com)
# In dev: typically lvh.me which resolves to 127.0.0.1
# ----------------------------------------------------------------------------
PRIMARY_DOMAIN="jesushg.com"
NEXT_PUBLIC_PRIMARY_DOMAIN="jesushg.com"
NEXT_PUBLIC_DEV_DOMAIN="lvh.me:3000"

# Spotify is connected per tenant via Admin → Credentials → Spotify (OAuth).
# No Spotify env vars are required.

# UploadThing is configured per tenant in Admin → Credentials → UploadThing.
# No platform-level UploadThing env vars are required.

# AI providers (resume import / tailor / job drafts) are per tenant in
# Admin → Credentials → AI Models. No shared platform AI keys.
# Full split: docs/tenant-credentials.md

# Optional: dedicated key for encrypting tenant integration secrets at rest
# (min 16 chars). If unset, BETTER_AUTH_SECRET is used.
# INTEGRATION_ENCRYPTION_KEY=""

# Isolated CV PDF generator. Required in production (min 16 chars).
# Also used as HMAC key for x-cv-pdf-tenant-proof on apex/preview hosts.
# CV_PDF_GENERATOR_SECRET=""
