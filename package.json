{
  "name": "portfolio-v2",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "lint-staged": {
    "src/components/ui/**/*.{ts,tsx}": [
      "node scripts/check-no-dark.mjs"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type": "tsc --noEmit",
    "db:migrate": "npx prisma migrate dev --name user-entity --create-only && yarn prisma generate",
    "db:push": "node scripts/validate-mongodb-uri.mjs && npx prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "npx prisma db seed",
    "prettier": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --project=login --project=public-locale --project=smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:full": "playwright test --project=register --project=setup --project=skills --project=projects --project=certifications --project=profile --project=timeline --project=soft-skills --project=cv",
    "test:e2e:full:ui": "playwright test --project=register --project=setup --project=skills --project=projects --project=certifications --project=profile --project=timeline --project=soft-skills --project=cv --ui",
    "test:e2e:full:headed": "playwright test --project=register --project=setup --project=skills --project=projects --project=certifications --project=profile --project=timeline --project=soft-skills --project=cv --headed"
  },
