{
  "name": "portfolio-v2",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "lint-staged": {
    "src/components/ui/**/*.{ts,tsx}": [
      "node scripts/check-no-dark.mjs"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "next build",
    "analyze": "next build && node scripts/report-bundle-sizes.mjs",
    "start": "next start",
    "lint": "eslint . --fix",
    "type": "tsc --noEmit",
    "db:migrate": "npx prisma migrate dev --name user-entity --create-only && yarn prisma generate",
    "db:push": "node scripts/validate-mongodb-uri.mjs && npx prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "npx prisma db seed",
    "db:seed:projects": "npx tsx prisma/seed-portfolio-projects.ts",
    "db:auth-audit": "npx tsx prisma/scripts/audit-account-identity.ts",
    "db:auth-backfill": "npx tsx prisma/scripts/backfill-account-issuer.ts",
    "prettier": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:full": "node scripts/e2e-full.mjs",
    "test:a11y": "playwright test --project=a11y",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "update:previews": "node scripts/generate-previews.mjs"
  },
