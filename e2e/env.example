# Copy these variables into your local .env.local (never commit real values).
# Used by both `pnpm db:seed` and Playwright e2e login.
#
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/portfolio_e2e
# OWNER_USER_EMAIL=your-email@example.com
# OWNER_USER_PASSWORD=your-secure-password
#
# Optional — defaults to http://localhost:3000 (local dev server / CI runner).
# Set to a Vercel Preview URL when running smoke tests against a deployed preview.
# E2E_BASE_URL=https://your-project-git-branch.vercel.app
#
# Required when Preview has Vercel Deployment Protection enabled.
# Generate in Vercel → Project → Settings → Deployment Protection → Protection Bypass for Automation.
# VERCEL_AUTOMATION_BYPASS_SECRET=your-bypass-secret
#
# CI uses GitHub Secrets with the same names (see docs/testing.md).
