// ============================================================================
// PORTFOLIO CONTENT MODELS (tenant-scoped via userId)
// ============================================================================

enum ProjectKind {
  PROFESSIONAL
  PERSONAL
  LEARNING
}

enum ProjectStatus {
  IN_PRODUCTION
  MAINTENANCE
  ARCHIVED
}

type CaseStudyItem {
  key     String
  title   String
  summary String?
  body    String?
  value   String?
  icon    String?
  tags    String[]
  note    String?
}

type CaseStudyFact {
  key   String
  label String
  value String
}

type CaseStudyGalleryItem {
  title       String
  description String?
  image       String
  icon        String?
}

type CaseStudySection {
  key             String
  kind            String
  eyebrow         String?
  title           String
  lead            String?
  code            String?
  codeLabel       String?
  items           CaseStudyItem[]
  footnoteTitle   String?
  footnotes       String[]
  footnoteVariant String?
}

type CaseStudyContent {
  chips            String[]
  facts            CaseStudyFact[]
  gallery          CaseStudyGalleryItem[]
  nextProjectSlug  String?
  context          String?
  roleTitle        String?
  roleIntro        String?
  tldr             CaseStudyItem[]
  responsibilities CaseStudyItem[]
  sections         CaseStudySection[]
}

model Project {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  userId             String?              @db.ObjectId
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  image              String
  type               StackType
  githubUrl          String?
  websiteUrl         String?
  isPrivate          Boolean              @default(false)
  order              Int                  @default(0)
  kind               ProjectKind          @default(PERSONAL)
  slug               String?
  caseStudyEnabled   Boolean              @default(false)
  status             ProjectStatus?
  startedAt          DateTime?
  endedAt            DateTime?
  teamSize           Int?
  ProjectSkill       ProjectSkill[]
  ProjectTranslation ProjectTranslation[]
  CertificateProject CertificateProject[]
}

model ProjectSkill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  Skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String   @db.ObjectId
  projectId String   @db.ObjectId

  @@unique([projectId, skillId])
}

model ProjectTranslation {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime          @default(now())
  title         String
  description   String
  caseStudy     CaseStudyContent?
  language      AppLanguage       @relation(fields: [appLanguageId], references: [id])
  Project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appLanguageId String            @db.ObjectId
  projectId     String            @db.ObjectId

  @@unique([projectId, appLanguageId])
}

model Testimonial {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String                   @db.ObjectId
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  author                 String
  role                   String
  avatarUrl              String?
  linkedInUrl            String?
  order                  Int                      @default(0)
  isVisible              Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  TestimonialTranslation TestimonialTranslation[]
}

model TestimonialTranslation {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime     @default(now())
  quote         String
  language      AppLanguage  @relation(fields: [appLanguageId], references: [id])
  Testimonial   Testimonial? @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  testimonialId String?      @db.ObjectId
  appLanguageId String       @db.ObjectId

  @@unique([testimonialId, appLanguageId])
}

model Service {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  userId             String?              @db.ObjectId
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  image              String
  type               StackType
  icon               String?              @default("code")
  statsValue         String?              @default("")
  featured           Boolean              @default(false)
  isActive           Boolean              @default(true)
  order              Int                  @default(0)
  ServiceTranslation ServiceTranslation[]
  CertificateService CertificateService[]
  ServiceSkill       ServiceSkill[]
}

model ServiceTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  title         String
  description   String
  badge         String?     @default("")
  statsLabel    String?     @default("")
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  Service       Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId     String?     @db.ObjectId
  appLanguageId String      @db.ObjectId
}

model Skill {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  userId            String              @db.ObjectId
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  image             String
  title             String
  type              StackType
  featured          Boolean             @default(false)
  trend             Boolean             @default(false)
  ProjectSkill      ProjectSkill[]
  SkillTranslation  SkillTranslation[]
  CertificateSkill  CertificateSkill[]
  ServiceSkill      ServiceSkill[]
  CvExperienceSkill CvExperienceSkill[]
  cvTechnicalSelections CvTechnicalSkillSelection[]
  TimelineItemSkill TimelineItemSkill[]

  @@unique([userId, title])
}

model SkillTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  description   String
  urlWiki       String
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  Skill         Skill?      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId       String?     @db.ObjectId
  appLanguageId String      @db.ObjectId
}

model Certification {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String?                    @db.ObjectId
  user                     User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime                   @default(now())
  company                  String
  issuedDate               Int?
  url                      String?
  idCredential             String?
  image                    String?
  type                     StackType[]
  CertificateSkill         CertificateSkill[]
  CertificationTranslation CertificationTranslation[]
  CertificateProject       CertificateProject[]
  CertificateService       CertificateService[]
}

model CertificationTranslation {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime             @default(now())
  title              String
  language           AppLanguage          @relation(fields: [appLanguageId], references: [id])
  Certification      Certification?       @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId    String?              @db.ObjectId
  appLanguageId      String               @db.ObjectId
  CertificateService CertificateService[]
}

//an certificate can validate multiple skills
//an skill can be validated by multiple certificates
model CertificateSkill {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime      @default(now())
  Certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  Skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  certificationId String        @db.ObjectId
  skillId         String        @db.ObjectId

  @@unique([certificationId, skillId])
}

//an certificate can validate multiple projects
//an project can be validated by multiple certificates
model CertificateProject {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime      @default(now())
  Certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  Project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  certificationId String        @db.ObjectId
  projectId       String        @db.ObjectId

  @@unique([projectId, certificationId])
}

model ServiceSkill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  Service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  Skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  serviceId String   @db.ObjectId
  skillId   String   @db.ObjectId

  @@unique([serviceId, skillId])
}

//an certificate can validate multiple services
//an service can be validated by multiple certificates
model CertificateService {
  id                         String                    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                  DateTime                  @default(now())
  Certification              Certification             @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  Service                    Service                   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  certificationId            String                    @db.ObjectId
  serviceId                  String                    @db.ObjectId
  CertificationTranslation   CertificationTranslation? @relation(fields: [certificationTranslationId], references: [id], onDelete: Cascade)
  certificationTranslationId String?                   @db.ObjectId
}

enum StackType {
  FRONTEND
  BACKEND
  MOBILE
  DESKTOP
  CYBERSECURITY
  DEVOPS
  SOFTSKILLS
  TOOLS
  ARCHITECTURE
  DATA
  QUALITY_DELIVERY
  AI
}

model TimelineItem {
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String                    @db.ObjectId
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                TimelineCategory
  organization            String
  location                String?
  startDate               DateTime
  endDate                 DateTime?
  current                 Boolean                   @default(false)
  order                   Int                       @default(0)
  images                  String[]                  @default([])
  technologies            String[]                  @default([])
  roles                   TimelineRole[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  TimelineItemTranslation TimelineItemTranslation[]
  TimelineItemSkill       TimelineItemSkill[]
}

model TimelineItemSkill {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime     @default(now())
  timelineItem   TimelineItem @relation(fields: [timelineItemId], references: [id], onDelete: Cascade)
  skill          Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  timelineItemId String       @db.ObjectId
  skillId        String       @db.ObjectId

  @@unique([timelineItemId, skillId])
}

type TimelineRole {
  title     String
  startDate String
  endDate   String?
}

model TimelineItemTranslation {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime      @default(now())
  title          String
  description    String
  language       AppLanguage   @relation(fields: [appLanguageId], references: [id])
  TimelineItem   TimelineItem? @relation(fields: [timelineItemId], references: [id], onDelete: Cascade)
  timelineItemId String?       @db.ObjectId
  appLanguageId  String        @db.ObjectId

  @@unique([timelineItemId, appLanguageId])
}

enum TimelineCategory {
  WORK
  STUDY
  COURSE
}

enum SoftSkillsMediaType {
  VIDEO
  IMAGE
}

model PortfolioSoftSkill {
  id                            String                          @id @default(auto()) @map("_id") @db.ObjectId
  userId                        String                          @db.ObjectId
  user                          User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon                          String
  isVisible                     Boolean                         @default(true)
  featured                      Boolean                         @default(false)
  order                         Int                             @default(0)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  PortfolioSoftSkillTranslation PortfolioSoftSkillTranslation[]

  @@index([userId, order])
}

model PortfolioSoftSkillTranslation {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt            DateTime            @default(now())
  title                String
  description          String
  badge                String?             @default("")
  language             AppLanguage         @relation(fields: [appLanguageId], references: [id])
  PortfolioSoftSkill   PortfolioSoftSkill? @relation(fields: [portfolioSoftSkillId], references: [id], onDelete: Cascade)
  portfolioSoftSkillId String?             @db.ObjectId
  appLanguageId        String              @db.ObjectId

  @@unique([portfolioSoftSkillId, appLanguageId])
}

model SoftSkillsSection {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String              @unique @db.ObjectId
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType SoftSkillsMediaType @default(VIDEO)
  videoUrl  String?
  posterUrl String?
  imageUrl  String?
  metrics   SoftSkillsMetric[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model SoftSkillsMetric {
  id                          String                        @id @default(auto()) @map("_id") @db.ObjectId
  sectionId                   String                        @db.ObjectId
  section                     SoftSkillsSection             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  value                       String
  order                       Int                           @default(0)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  SoftSkillsMetricTranslation SoftSkillsMetricTranslation[]

  @@index([sectionId, order])
}

model SoftSkillsMetricTranslation {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  metricId      String           @db.ObjectId
  metric        SoftSkillsMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  appLanguageId String           @db.ObjectId
  language      AppLanguage      @relation(fields: [appLanguageId], references: [id])
  label         String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([metricId, appLanguageId])
}

// ============================================================================
// USES PAGE (inventory + media settings)
// ============================================================================

enum UsesItemType {
  EVERYDAY
  SOFTWARE
  BROWSER
}

model UsesItem {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  userId              String                @db.ObjectId
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                UsesItemType
  href                String
  image               String?
  order               Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  UsesItemTranslation UsesItemTranslation[]
  UsesWorkspaceTag    UsesWorkspaceTag[]
}

model UsesItemTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  title         String
  description   String?
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  UsesItem      UsesItem?   @relation(fields: [usesItemId], references: [id], onDelete: Cascade)
  usesItemId    String?     @db.ObjectId
  appLanguageId String      @db.ObjectId

  @@unique([usesItemId, appLanguageId])
}

model UsesSettings {
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String                    @unique @db.ObjectId
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceImage          String?
  codingPreviewLight      String?
  codingPreviewDark       String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  UsesSettingsTranslation UsesSettingsTranslation[]
  UsesClarification       UsesClarification[]
  UsesWorkspaceTag        UsesWorkspaceTag[]
}

model UsesSettingsTranslation {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime      @default(now())
  codingIntro    String        @default("")
  browserIntro   String        @default("")
  language       AppLanguage   @relation(fields: [appLanguageId], references: [id])
  UsesSettings   UsesSettings? @relation(fields: [usesSettingsId], references: [id], onDelete: Cascade)
  usesSettingsId String?       @db.ObjectId
  appLanguageId  String        @db.ObjectId

  @@unique([usesSettingsId, appLanguageId])
}

model UsesClarification {
  id                           String                         @id @default(auto()) @map("_id") @db.ObjectId
  usesSettingsId               String                         @db.ObjectId
  UsesSettings                 UsesSettings                   @relation(fields: [usesSettingsId], references: [id], onDelete: Cascade)
  order                        Int                            @default(0)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  UsesClarificationTranslation UsesClarificationTranslation[]

  @@index([usesSettingsId, order])
}

model UsesClarificationTranslation {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  createdAt           DateTime           @default(now())
  body                String
  language            AppLanguage        @relation(fields: [appLanguageId], references: [id])
  UsesClarification   UsesClarification? @relation(fields: [usesClarificationId], references: [id], onDelete: Cascade)
  usesClarificationId String?            @db.ObjectId
  appLanguageId       String             @db.ObjectId

  @@unique([usesClarificationId, appLanguageId])
}

model UsesWorkspaceTag {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  usesSettingsId String       @db.ObjectId
  UsesSettings   UsesSettings @relation(fields: [usesSettingsId], references: [id], onDelete: Cascade)
  usesItemId     String       @db.ObjectId
  UsesItem       UsesItem     @relation(fields: [usesItemId], references: [id], onDelete: Cascade)
  xPercent       Float
  yPercent       Float
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([usesSettingsId, usesItemId])
  @@index([usesSettingsId, order])
  @@index([usesItemId])
}

// ============================================================================
// NOW PAGE (snapshot settings + focuses)
// ============================================================================

model NowSettings {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String                   @unique @db.ObjectId
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone               String                   @default("America/Mexico_City")
  githubUsername         String?
  statusEmoji            String                   @default("🚀")
  statusSchedule         NowStatusSlot[]
  readingCoverUrl        String?
  watchedCoverUrl        String?
  readingTitle           String?
  readingAuthors         String?
  readingProgress        Int                      @default(0)
  watchedTitle           String?
  watchedRating          Int                      @default(0)
  photoUrls              String[]                 @default([])
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  NowSettingsTranslation NowSettingsTranslation[]
}

model NowSettingsTranslation {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime     @default(now())
  statusBody     String
  statusRelative String
  language       AppLanguage  @relation(fields: [appLanguageId], references: [id])
  NowSettings    NowSettings? @relation(fields: [nowSettingsId], references: [id], onDelete: Cascade)
  nowSettingsId  String?      @db.ObjectId
  appLanguageId  String       @db.ObjectId

  @@unique([nowSettingsId, appLanguageId])
}

model NowFocus {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  userId              String                @db.ObjectId
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order               Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  NowFocusTranslation NowFocusTranslation[]
}

model NowFocusTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  label         String
  body          String
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  NowFocus      NowFocus?   @relation(fields: [nowFocusId], references: [id], onDelete: Cascade)
  nowFocusId    String?     @db.ObjectId
  appLanguageId String      @db.ObjectId

  @@unique([nowFocusId, appLanguageId])
}

// ============================================================================
// PROCESS PAGES (workflow / QA templates)
// ============================================================================

enum ProcessPageTemplate {
  WORKFLOW
  QA
}

model ProcessPage {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String                   @db.ObjectId
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                   String
  template               ProcessPageTemplate
  isPublished            Boolean                  @default(false)
  showInNav              Boolean                  @default(false)
  order                  Int                      @default(0)
  navIcon                String                   @default("Bot")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  ProcessPageTranslation ProcessPageTranslation[]

  @@unique([userId, slug])
  @@index([userId, order])
  @@index([userId, isPublished, showInNav])
}

model ProcessPageTranslation {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime     @default(now())
  metaTitle          String       @default("")
  metaDescription    String       @default("")
  menuTitle          String       @default("")
  navDescription     String       @default("")
  pageNavLabel       String       @default("")
  heroEyebrow        String       @default("")
  heroTitle          String       @default("")
  heroTitleHighlight String       @default("")
  heroDescription    String       @default("")
  heroPrimaryCta     String       @default("")
  heroSecondaryCta   String       @default("")
  heroScrollHint     String       @default("")
  ctaTitle           String       @default("")
  ctaDescription     String       @default("")
  ctaButton          String       @default("")
  content            Json
  language           AppLanguage  @relation(fields: [appLanguageId], references: [id])
  ProcessPage        ProcessPage? @relation(fields: [processPageId], references: [id], onDelete: Cascade)
  processPageId      String?      @db.ObjectId
  appLanguageId      String       @db.ObjectId

  @@unique([processPageId, appLanguageId])
}

// ============================================================================
// SPOTIFY OAUTH (per-user connection for Now Playing widget)
// ============================================================================

model SpotifyConnection {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String
  clientSecretEnc    String
  refreshTokenEnc    String
  scope              String?
  connectedAt        DateTime  @default(now())
  lastRefreshErrorAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SpotifyOAuthState {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  state           String   @unique
  userId          String   @db.ObjectId
  clientId        String
  clientSecretEnc String
  codeVerifier    String
  locale          String   @default("en")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

// ============================================================================
// GOOGLE CALENDAR OAUTH (per-user BYO client for job tracker sync)
// ============================================================================

model GoogleCalendarConnection {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String
  clientSecretEnc    String
  refreshTokenEnc    String
  scope              String?
  calendarId         String    @default("primary")
  connectedAt        DateTime  @default(now())
  lastPullAt         DateTime?
  lastRefreshErrorAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model GoogleCalendarOAuthState {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  state           String   @unique
  userId          String   @db.ObjectId
  clientId        String
  clientSecretEnc String
  codeVerifier    String
  locale          String   @default("en")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

// ============================================================================
// TENANT INTEGRATIONS (Multi-tenant credentials for Resend, Spotify, UploadThing, AI)
// ============================================================================

model TenantIntegration {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // "resend" | "spotify" | "uploadthing" | "gemini" | "openai" | "anthropic"
  enabled        Boolean   @default(true)
  credentialsEnc String // AES-256-GCM encrypted JSON
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
}

model NowStatusSlot {
  id            String                     @id @default(auto()) @map("_id") @db.ObjectId
  nowSettingsId String                     @db.ObjectId
  settings      NowSettings                @relation(fields: [nowSettingsId], references: [id], onDelete: Cascade)
  startMinute   Int
  endMinute     Int
  weekdays      Int[]
  emoji         String                     @default("💼")
  translations  NowStatusSlotTranslation[]

  @@index([nowSettingsId])
}

model NowStatusSlotTranslation {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  slotId        String        @db.ObjectId
  slot          NowStatusSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  appLanguageId String        @db.ObjectId
  language      AppLanguage   @relation(fields: [appLanguageId], references: [id])
  body          String

  @@unique([slotId, appLanguageId])
}
