// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// CORE USER MODEL
// ============================================================================

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  /// Better Auth two-factor plugin flag (TOTP + email OTP, opt-in per user).
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  passkeys   Passkey[]
  profile    Profile?

  // Per-user CV
  CvHeader            CvHeader?
  CvAboutMe           CvAboutMe?
  CvContact           CvContact[]
  CvEducation         CvEducation[]
  CvLanguage          CvLanguage[]
  CvTechnicalSkill    CvTechnicalSkill[]
  CvExperience        CvExperience[]
  CvSoftSkill         CvSoftSkill[]
  CvAdditionalInfo    CvAdditionalInfo[]
  CvPersonalReference CvPersonalReference[]
  CvPdfLink           CvPdfLink[]

  // Per-user Home
  portfolioTerminal PortfolioTerminal?

  // Per-user portfolio (existing models become tenant-scoped)
  Project                  Project[]
  Skill                    Skill[]
  Service                  Service[]
  Certification            Certification[]
  TimelineItem             TimelineItem[]
  PortfolioSoftSkill       PortfolioSoftSkill[]
  SoftSkillsSection        SoftSkillsSection?
  SpotifyConnection        SpotifyConnection?
  GoogleCalendarConnection GoogleCalendarConnection?
  Testimonial              Testimonial[]
  TenantIntegration        TenantIntegration[]
  UsesItem                 UsesItem[]
  UsesSettings             UsesSettings?
  NowSettings              NowSettings?
  NowFocus                 NowFocus[]
  ProcessPage              ProcessPage[]

  // Job Tracker
  Company               Company[]
  JobSearch             JobSearch[]
  Application           Application[]
  ApplicationEvent      ApplicationEvent[]
  ApplicationEmail      ApplicationEmail[]
  Document              Document[]
  InterviewPrepQuestion InterviewPrepQuestion[]

  // Resume Engine
  CvSourceUpload CvSourceUpload[]
  ResumeExport   ResumeExport[]
  CvPdfEmailLog  CvPdfEmailLog[]

  // First-party audience measurement (aggregated, no IPs)
  AnalyticsDailyStat AnalyticsDailyStat[]
}

// ============================================================================
// APP LANGUAGES & LOCALIZATION
// ============================================================================

model AppLanguage {
  id                               String                             @id @default(auto()) @map("_id") @db.ObjectId
  code                             String                             @unique
  name                             String
  SkillTranslation                 SkillTranslation[]
  ProjectTranslation               ProjectTranslation[]
  ServiceTranslation               ServiceTranslation[]
  CertificationTranslation         CertificationTranslation[]
  PortfolioTerminalStepTranslation PortfolioTerminalStepTranslation[]
  PortfolioSoftSkillTranslation    PortfolioSoftSkillTranslation[]
  TimelineItemTranslation          TimelineItemTranslation[]
  TestimonialTranslation           TestimonialTranslation[]
  CvHeaderTranslation              CvHeaderTranslation[]
  CvAboutMeTranslation             CvAboutMeTranslation[]
  CvEducationTranslation           CvEducationTranslation[]
  CvExperienceTranslation          CvExperienceTranslation[]
  CvResponsibilityTranslation      CvResponsibilityTranslation[]
  CvLanguageTranslation            CvLanguageTranslation[]
  CvSoftSkillTranslation           CvSoftSkillTranslation[]
  CvAdditionalInfoTranslation      CvAdditionalInfoTranslation[]
  CvPersonalReferenceTranslation   CvPersonalReferenceTranslation[]
  CvContactTranslation             CvContactTranslation[]
  UsesItemTranslation              UsesItemTranslation[]
  UsesSettingsTranslation          UsesSettingsTranslation[]
  UsesClarificationTranslation     UsesClarificationTranslation[]
  NowSettingsTranslation           NowSettingsTranslation[]
  NowFocusTranslation              NowFocusTranslation[]
  ProcessPageTranslation           ProcessPageTranslation[]
  SoftSkillsMetricTranslation      SoftSkillsMetricTranslation[]
}
