// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// AUTH MODELS (Better Auth)
// ============================================================================

model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  /// Better Auth two-factor plugin flag (TOTP + email OTP, opt-in per user).
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  passkeys   Passkey[]
  profile    Profile?

  // Per-user CV
  CvHeader            CvHeader?
  CvAboutMe           CvAboutMe?
  CvTerminal          CvTerminal?
  CvContact           CvContact[]
  CvEducation         CvEducation[]
  CvLanguage          CvLanguage[]
  CvTechnicalSkill    CvTechnicalSkill[]
  CvExperience        CvExperience[]
  CvSoftSkill         CvSoftSkill[]
  CvAdditionalInfo    CvAdditionalInfo[]
  CvPersonalReference CvPersonalReference[]
  CvPdfLink           CvPdfLink[]
  CvHeroTitle         CvHeroTitle[]

  // Per-user portfolio (existing models become tenant-scoped)
  Project            Project[]
  Skill              Skill[]
  Service            Service[]
  Certification      Certification[]
  TimelineItem       TimelineItem[]
  PortfolioSoftSkill PortfolioSoftSkill[]
  SoftSkillsSection  SoftSkillsSection?
  SpotifyConnection         SpotifyConnection?
  GoogleCalendarConnection  GoogleCalendarConnection?
  Testimonial               Testimonial[]
  TenantIntegration         TenantIntegration[]
  UsesItem           UsesItem[]
  UsesSettings       UsesSettings?
  NowSettings        NowSettings?
  NowFocus           NowFocus[]
  ProcessPage        ProcessPage[]

  // Job Tracker
  Company               Company[]
  Application           Application[]
  ApplicationEvent      ApplicationEvent[]
  Document              Document[]
  InterviewPrepQuestion InterviewPrepQuestion[]

  // Resume Engine
  CvSourceUpload CvSourceUpload[]
  ResumeExport   ResumeExport[]
  CvPdfEmailLog  CvPdfEmailLog[]

  // First-party audience measurement (aggregated, no IPs)
  AnalyticsDailyStat AnalyticsDailyStat[]
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  /// Better Auth 1.7 identity namespace ("local:credential", "local:oauth:<provider>").
  /// Existing rows are backfilled by `pnpm db:auth-backfill` before `db:push`.
  issuer                String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Better Auth `twoFactor` plugin table (ids generated by Better Auth, see auth.ts generateId).
model TwoFactor {
  id                      String    @id @default(cuid()) @map("_id")
  secret                  String
  backupCodes             String
  userId                  String    @db.ObjectId
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

/// Better Auth `@better-auth/passkey` plugin table (WebAuthn credentials).
model Passkey {
  id           String    @id @default(cuid()) @map("_id")
  name         String?
  publicKey    String
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())

  @@index([userId])
}

/// Better Auth rate limiter storage (`rateLimit.storage: "database"`), shared across serverless instances.
model RateLimit {
  id          String @id @default(cuid()) @map("_id")
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ============================================================================
// TENANT / PROFILE
// ============================================================================

model Profile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username         String   @unique
  displayName      String?
  /// Text logo shown in the public header/footer when no logoImageUrl is set.
  logoInitials     String?
  /// Optional image logo URL. When set, takes precedence over logoInitials.
  logoImageUrl     String?
  defaultLocale    String   @default("en")
  isPrimary        Boolean  @default(false)
  isPublished      Boolean  @default(false)
  /// Optional custom domain. Not @unique: MongoDB unique indexes only allow
  /// one null, which breaks multi-user signup. Enforce uniqueness in app code
  /// when a domain is actually set.
  customDomain     String?
  /// City or place shown on the Let's Talk map (geocoded on save).
  mapLocationLabel String?
  mapLatitude      Float?
  mapLongitude     Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// CV PDF LINKS (per-user, per-locale)
// ============================================================================

/// Stores a separate PDF download URL for each locale so users can have
/// language-specific CV files (e.g., a Spanish CV and an English CV).
model CvPdfLink {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// BCP-47 locale code, e.g. "en", "es", "nl"
  locale        String
  /// Direct URL to the PDF file
  url           String
  /// Optional human-readable label, e.g. "Currículum en Español"
  label         String?
  /// Whether the PDF uses US Letter pagination or a single continuous page
  paginatePages Boolean   @default(false)
  /// SHA-256 of rendered CV content; null = manually managed URL (legacy)
  contentHash   String?
  /// UploadThing file key for replacing/deleting cached PDFs
  storageKey    String?
  generatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, locale, paginatePages])
}

model CvPdfEmailLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash         String
  recipientEmail String
  locale         String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([recipientEmail, createdAt])
}

// ============================================================================
// CV MODELS (per-user, multi-locale via relational *Translation models)
// ============================================================================

model CvHeader {
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  userId             String                @unique @db.ObjectId
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  photoUrl           String?
  backgroundImageUrl String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  translations       CvHeaderTranslation[]
}

model CvHeaderTranslation {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime    @default(now())
  degree         String
  heroSubtitle   String?
  heroTagline    String?
  heroSummary    String?
  clientImageAlt String?
  language       AppLanguage @relation(fields: [appLanguageId], references: [id])
  CvHeader       CvHeader?   @relation(fields: [cvHeaderId], references: [id], onDelete: Cascade)
  cvHeaderId     String?     @db.ObjectId
  appLanguageId  String      @db.ObjectId

  @@unique([cvHeaderId, appLanguageId])
}

/// Rotating professional titles shown in the portfolio hero typewriter.
model CvHeroTitle {
  id           String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                   @db.ObjectId
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Int                      @default(0)
  translations CvHeroTitleTranslation[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId, order])
}

model CvHeroTitleTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  heroTitleId   String      @db.ObjectId
  heroTitle     CvHeroTitle @relation(fields: [heroTitleId], references: [id], onDelete: Cascade)
  appLanguageId String      @db.ObjectId
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  text          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([heroTitleId, appLanguageId])
}

model CvAboutMe {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                 @unique @db.ObjectId
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations CvAboutMeTranslation[]
}

model CvAboutMeTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  aboutMe       String
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  CvAboutMe     CvAboutMe?  @relation(fields: [cvAboutMeId], references: [id], onDelete: Cascade)
  cvAboutMeId   String?     @db.ObjectId
  appLanguageId String      @db.ObjectId

  @@unique([cvAboutMeId, appLanguageId])
}

/// Configurable terminal sequence for the portfolio About section.
model CvTerminal {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  userId               String           @unique @db.ObjectId
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  username             String           @default("Jesus-Macbook")
  typingSpeed          Int              @default(45)
  delayBetweenCommands Int              @default(1000)
  steps                CvTerminalStep[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model CvTerminalStep {
  id           String                      @id @default(auto()) @map("_id") @db.ObjectId
  terminalId   String                      @db.ObjectId
  terminal     CvTerminal                  @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  order        Int                         @default(0)
  translations CvTerminalStepTranslation[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([terminalId, order])
}

model CvTerminalStepTranslation {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  stepId        String         @db.ObjectId
  step          CvTerminalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  appLanguageId String         @db.ObjectId
  language      AppLanguage    @relation(fields: [appLanguageId], references: [id])
  command       String
  output        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([stepId, appLanguageId])
}

model CvContact {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                 @db.ObjectId
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CvContactType
  value        String
  order        Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  translations CvContactTranslation[]
}

model CvContactTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  label         String
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  CvContact     CvContact?  @relation(fields: [cvContactId], references: [id], onDelete: Cascade)
  cvContactId   String?     @db.ObjectId
  appLanguageId String      @db.ObjectId

  @@unique([cvContactId, appLanguageId])
}

model CvEducation {
  id           String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                   @db.ObjectId
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  String
  startYear    Int?
  endYear      Int?
  dates        String?
  order        Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations CvEducationTranslation[]
}

model CvEducationTranslation {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime     @default(now())
  degreeName    String
  location      String?
  description   String?
  language      AppLanguage  @relation(fields: [appLanguageId], references: [id])
  CvEducation   CvEducation? @relation(fields: [cvEducationId], references: [id], onDelete: Cascade)
  cvEducationId String?      @db.ObjectId
  appLanguageId String       @db.ObjectId

  @@unique([cvEducationId, appLanguageId])
}

model CvLanguage {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                  @db.ObjectId
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations CvLanguageTranslation[]
}

model CvLanguageTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  name          String
  level         String
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  CvLanguage    CvLanguage? @relation(fields: [cvLanguageId], references: [id], onDelete: Cascade)
  cvLanguageId  String?     @db.ObjectId
  appLanguageId String      @db.ObjectId

  @@unique([cvLanguageId, appLanguageId])
}

model CvTechnicalSkill {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  userId    String          @db.ObjectId
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  CvSkillCategory
  items     String[]
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CvExperience {
  id                String                    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String                    @db.ObjectId
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company           String
  companyLogoUrl    String?
  startDate         DateTime?
  endDate           DateTime?
  current           Boolean                   @default(false)
  featuredOnHome    Boolean                   @default(false)
  skills            String?
  order             Int                       @default(0)
  responsibilities  CvResponsibility[]
  CvExperienceSkill CvExperienceSkill[]
  translations      CvExperienceTranslation[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model CvExperienceTranslation {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime      @default(now())
  role           String
  location       String?
  /// Short factual blurb for ATS tailor context (industry / product / what you worked on). Not printed on the public CV by default.
  companyBlurb   String?
  language       AppLanguage   @relation(fields: [appLanguageId], references: [id])
  CvExperience   CvExperience? @relation(fields: [cvExperienceId], references: [id], onDelete: Cascade)
  cvExperienceId String?       @db.ObjectId
  appLanguageId  String        @db.ObjectId

  @@unique([cvExperienceId, appLanguageId])
}

model CvResponsibility {
  id           String                        @id @default(auto()) @map("_id") @db.ObjectId
  experienceId String                        @db.ObjectId
  experience   CvExperience                  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  order        Int                           @default(0)
  /// When true, bullet is hidden from the printed/public CV but available as an ATS tailor bank.
  atsOnly      Boolean                       @default(false)
  createdAt    DateTime                      @default(now())
  translations CvResponsibilityTranslation[]
}

model CvResponsibilityTranslation {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime          @default(now())
  text               String
  language           AppLanguage       @relation(fields: [appLanguageId], references: [id])
  CvResponsibility   CvResponsibility? @relation(fields: [cvResponsibilityId], references: [id], onDelete: Cascade)
  cvResponsibilityId String?           @db.ObjectId
  appLanguageId      String            @db.ObjectId

  @@unique([cvResponsibilityId, appLanguageId])
}

model CvExperienceSkill {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  experienceId String       @db.ObjectId
  skillId      String       @db.ObjectId
  experience   CvExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([experienceId, skillId])
}

model CvSoftSkill {
  id           String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                   @db.ObjectId
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations CvSoftSkillTranslation[]
}

model CvSoftSkillTranslation {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime     @default(now())
  name          String
  language      AppLanguage  @relation(fields: [appLanguageId], references: [id])
  CvSoftSkill   CvSoftSkill? @relation(fields: [cvSoftSkillId], references: [id], onDelete: Cascade)
  cvSoftSkillId String?      @db.ObjectId
  appLanguageId String       @db.ObjectId

  @@unique([cvSoftSkillId, appLanguageId])
}

model CvAdditionalInfo {
  id           String                        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                        @db.ObjectId
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Int                           @default(0)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  translations CvAdditionalInfoTranslation[]
}

model CvAdditionalInfoTranslation {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime          @default(now())
  text               String
  language           AppLanguage       @relation(fields: [appLanguageId], references: [id])
  CvAdditionalInfo   CvAdditionalInfo? @relation(fields: [cvAdditionalInfoId], references: [id], onDelete: Cascade)
  cvAdditionalInfoId String?           @db.ObjectId
  appLanguageId      String            @db.ObjectId

  @@unique([cvAdditionalInfoId, appLanguageId])
}

model CvPersonalReference {
  id           String                           @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                           @db.ObjectId
  user         User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  contact      String?
  order        Int                              @default(0)
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  translations CvPersonalReferenceTranslation[]
}

model CvPersonalReferenceTranslation {
  id                    String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt             DateTime             @default(now())
  role                  String
  language              AppLanguage          @relation(fields: [appLanguageId], references: [id])
  CvPersonalReference   CvPersonalReference? @relation(fields: [cvPersonalReferenceId], references: [id], onDelete: Cascade)
  cvPersonalReferenceId String?              @db.ObjectId
  appLanguageId         String               @db.ObjectId

  @@unique([cvPersonalReferenceId, appLanguageId])
}

enum CvContactType {
  EMAIL
  PHONE
  LINKEDIN
  GITHUB
  WEBSITE
  LOCATION
  CALENDLY
  OTHER
}

enum CvSkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  TOOLS
  MOBILE
  DESKTOP
  DEVOPS
  CYBERSECURITY
  OTHER
}

// ============================================================================
// PORTFOLIO MODELS (now tenant-scoped via userId)
// ============================================================================

model AppLanguage {
  id                             String                           @id @default(auto()) @map("_id") @db.ObjectId
  code                           String                           @unique
  name                           String
  SkillTranslation               SkillTranslation[]
  ProjectTranslation             ProjectTranslation[]
  ServiceTranslation             ServiceTranslation[]
  CertificationTranslation       CertificationTranslation[]
  CvTerminalStepTranslation      CvTerminalStepTranslation[]
  CvHeroTitleTranslation         CvHeroTitleTranslation[]
  PortfolioSoftSkillTranslation  PortfolioSoftSkillTranslation[]
  TimelineItemTranslation        TimelineItemTranslation[]
  TestimonialTranslation         TestimonialTranslation[]
  CvHeaderTranslation            CvHeaderTranslation[]
  CvAboutMeTranslation           CvAboutMeTranslation[]
  CvEducationTranslation         CvEducationTranslation[]
  CvExperienceTranslation        CvExperienceTranslation[]
  CvResponsibilityTranslation    CvResponsibilityTranslation[]
  CvLanguageTranslation          CvLanguageTranslation[]
  CvSoftSkillTranslation         CvSoftSkillTranslation[]
  CvAdditionalInfoTranslation    CvAdditionalInfoTranslation[]
  CvPersonalReferenceTranslation CvPersonalReferenceTranslation[]
  CvContactTranslation           CvContactTranslation[]
  UsesItemTranslation            UsesItemTranslation[]
  UsesSettingsTranslation        UsesSettingsTranslation[]
  UsesClarificationTranslation   UsesClarificationTranslation[]
  NowSettingsTranslation         NowSettingsTranslation[]
  NowFocusTranslation            NowFocusTranslation[]
  ProcessPageTranslation         ProcessPageTranslation[]
}

enum ProjectKind {
  PROFESSIONAL
  PERSONAL
  LEARNING
}

model Project {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  userId             String?              @db.ObjectId
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  image              String
  type               StackType
  githubUrl          String?
  websiteUrl         String?
  isPrivate          Boolean              @default(false)
  order              Int                  @default(0)
  kind               ProjectKind          @default(PERSONAL)
  slug               String?
  caseStudyEnabled   Boolean              @default(false)
  ProjectSkill       ProjectSkill[]
  ProjectTranslation ProjectTranslation[]
  CertificateProject CertificateProject[]
}

model ProjectSkill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  Skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String   @db.ObjectId
  projectId String   @db.ObjectId
}

model ProjectTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  title         String
  description   String
  hook          String?
  challenge     String?
  approach      String?
  outcome       String?
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  Project       Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appLanguageId String      @db.ObjectId
  projectId     String?     @db.ObjectId
}

model Testimonial {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String                   @db.ObjectId
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  author                 String
  role                   String
  avatarUrl              String?
  linkedInUrl            String?
  order                  Int                      @default(0)
  isVisible              Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  TestimonialTranslation TestimonialTranslation[]
}

model TestimonialTranslation {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime     @default(now())
  quote         String
  language      AppLanguage  @relation(fields: [appLanguageId], references: [id])
  Testimonial   Testimonial? @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  testimonialId String?      @db.ObjectId
  appLanguageId String       @db.ObjectId

  @@unique([testimonialId, appLanguageId])
}

model Service {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  userId             String?              @db.ObjectId
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  image              String
  type               StackType
  icon               String?              @default("code")
  statsValue         String?              @default("")
  featured           Boolean              @default(false)
  isActive           Boolean              @default(true)
