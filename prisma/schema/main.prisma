// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// AUTH MODELS (Better Auth)
// ============================================================================

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  profile  Profile?

  // Per-user CV
  CvHeader            CvHeader?
  CvAboutMe           CvAboutMe?
  CvTerminal          CvTerminal?
  CvContact           CvContact[]
  CvEducation         CvEducation[]
  CvLanguage          CvLanguage[]
  CvTechnicalSkill    CvTechnicalSkill[]
  CvExperience        CvExperience[]
  CvSoftSkill         CvSoftSkill[]
  CvAdditionalInfo    CvAdditionalInfo[]
  CvPersonalReference CvPersonalReference[]
  CvPdfLink           CvPdfLink[]
  CvHeroTitle         CvHeroTitle[]

  // Per-user portfolio (existing models become tenant-scoped)
  Project            Project[]
  Skill              Skill[]
  Service            Service[]
  Certification      Certification[]
  TimelineItem       TimelineItem[]
  PortfolioSoftSkill PortfolioSoftSkill[]
  SoftSkillsSection  SoftSkillsSection?
  SpotifyConnection  SpotifyConnection?
  Testimonial        Testimonial[]

  // Job Tracker
  Company            Company[]
  Application        Application[]
  ApplicationEvent   ApplicationEvent[]
  Document           Document[]

  // Resume Engine
  CvSourceUpload     CvSourceUpload[]
  ResumeExport       ResumeExport[]
  CvPdfEmailLog      CvPdfEmailLog[]
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================================
// TENANT / PROFILE
// ============================================================================

model Profile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String   @unique
  displayName   String?
  defaultLocale String   @default("en")
  isPrimary     Boolean  @default(false)
  isPublished   Boolean  @default(false)
  /// Optional custom domain. Not @unique: MongoDB unique indexes only allow
  /// one null, which breaks multi-user signup. Enforce uniqueness in app code
  /// when a domain is actually set.
  customDomain  String?
  cvPdfUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================================
// CV PDF LINKS (per-user, per-locale)
// ============================================================================

/// Stores a separate PDF download URL for each locale so users can have
/// language-specific CV files (e.g., a Spanish CV and an English CV).
model CvPdfLink {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// BCP-47 locale code, e.g. "en", "es", "nl"
  locale        String
  /// Direct URL to the PDF file
  url           String
  /// Optional human-readable label, e.g. "Currículum en Español"
  label         String?
  /// Whether the PDF uses US Letter pagination or a single continuous page
  paginatePages Boolean   @default(false)
  /// SHA-256 of rendered CV content; null = manually managed URL (legacy)
  contentHash   String?
  /// UploadThing file key for replacing/deleting cached PDFs
  storageKey    String?
  generatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, locale, paginatePages])
}

model CvPdfEmailLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash         String
  recipientEmail String
  locale         String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([recipientEmail, createdAt])
}

// ============================================================================
// CV MODELS (per-user, multi-locale via Json LocalizedText)
// LocalizedText shape:
//   { default: string, translations?: { en?: string, es?: string, nl?: string } }
// ============================================================================

model CvHeader {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  degree             Json
  photoUrl           String?
  backgroundImageUrl String?
  heroSubtitle       Json?
  heroTagline        Json?
  heroSummary        Json?
  clientImageAlt     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Rotating professional titles shown in the portfolio hero typewriter.
model CvHeroTitle {
  id           String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                   @db.ObjectId
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Int                      @default(0)
  translations CvHeroTitleTranslation[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId, order])
}

model CvHeroTitleTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  heroTitleId   String      @db.ObjectId
  heroTitle     CvHeroTitle @relation(fields: [heroTitleId], references: [id], onDelete: Cascade)
  appLanguageId String      @db.ObjectId
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  text          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([heroTitleId, appLanguageId])
}

model CvAboutMe {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aboutMe   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Configurable terminal sequence for the portfolio About section.
model CvTerminal {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  userId               String           @unique @db.ObjectId
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  username             String           @default("Jesus-Macbook")
  typingSpeed          Int              @default(45)
  delayBetweenCommands Int              @default(1000)
  steps                CvTerminalStep[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model CvTerminalStep {
  id           String                      @id @default(auto()) @map("_id") @db.ObjectId
  terminalId   String                      @db.ObjectId
  terminal     CvTerminal                  @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  order        Int                         @default(0)
  translations CvTerminalStepTranslation[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([terminalId, order])
}

model CvTerminalStepTranslation {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  stepId        String         @db.ObjectId
  step          CvTerminalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  appLanguageId String         @db.ObjectId
  language      AppLanguage    @relation(fields: [appLanguageId], references: [id])
  command       String
  output        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([stepId, appLanguageId])
}

model CvContact {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      CvContactType
  value     String
  label     Json?
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CvEducation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution String
  degreeName  Json
  location    Json?
  description Json?
  startYear   Int?
  endYear     Int?
  dates       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CvLanguage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      Json
  level     Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CvTechnicalSkill {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  userId    String          @db.ObjectId
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  CvSkillCategory
  items     String[]
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model CvExperience {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  userId            String              @db.ObjectId
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  company           String
  companyLogoUrl    String?
  role              Json
  location          Json?
  startDate         DateTime?
  endDate           DateTime?
  current           Boolean             @default(false)
  featuredOnHome    Boolean             @default(false)
  skills            String?
  order             Int                 @default(0)
  responsibilities  CvResponsibility[]
  CvExperienceSkill CvExperienceSkill[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model CvResponsibility {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  experienceId String       @db.ObjectId
  experience   CvExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  text         Json
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
}

model CvExperienceSkill {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  experienceId String       @db.ObjectId
  skillId      String       @db.ObjectId
  experience   CvExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@unique([experienceId, skillId])
}

model CvSoftSkill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CvAdditionalInfo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      Json
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CvPersonalReference {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      Json?
  contact   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CvContactType {
  EMAIL
  PHONE
  LINKEDIN
  GITHUB
  WEBSITE
  LOCATION
  CALENDLY
  OTHER
}

enum CvSkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  TOOLS
  MOBILE
  DESKTOP
  DEVOPS
  CYBERSECURITY
  OTHER
}

// ============================================================================
// PORTFOLIO MODELS (now tenant-scoped via userId)
// ============================================================================

model AppLanguage {
  id                        String                      @id @default(auto()) @map("_id") @db.ObjectId
  code                      String                      @unique
  name                      String
  SkillTranslation          SkillTranslation[]
  ProjectTranslation        ProjectTranslation[]
  ServiceTranslation        ServiceTranslation[]
  CertificationTranslation  CertificationTranslation[]
  CvTerminalStepTranslation CvTerminalStepTranslation[]
  CvHeroTitleTranslation    CvHeroTitleTranslation[]
}

enum ProjectKind {
  PROFESSIONAL
  PERSONAL
  LEARNING
}

model Project {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  userId             String?              @db.ObjectId
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  image              String
  type               StackType
  githubUrl          String?
  websiteUrl         String?
  isPrivate          Boolean              @default(false)
  order              Int                  @default(0)
  kind               ProjectKind          @default(PERSONAL)
  slug               String?
  caseStudyEnabled   Boolean              @default(false)
  ProjectSkill       ProjectSkill[]
  ProjectTranslation ProjectTranslation[]
  CertificateProject CertificateProject[]
}

model ProjectSkill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  Skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  Project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String   @db.ObjectId
  projectId String   @db.ObjectId
}

model ProjectTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  title         String
  description   String
  hook          String?
  challenge     String?
  approach      String?
  outcome       String?
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  Project       Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appLanguageId String      @db.ObjectId
  projectId     String?     @db.ObjectId
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  author    String
  role      String
  quote     Json
  avatarUrl String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  userId             String?              @db.ObjectId
  user               User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  image              String
  type               StackType
  ServiceTranslation ServiceTranslation[]
  CertificateService CertificateService[]
  ServiceSkill       ServiceSkill[]
}

model ServiceTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  title         String
  description   String
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  Service       Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId     String?     @db.ObjectId
  appLanguageId String      @db.ObjectId
}

model Skill {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  userId            String              @db.ObjectId
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  image             String
  title             String
  type              StackType
  featured          Boolean             @default(false)
  ProjectSkill      ProjectSkill[]
  SkillTranslation  SkillTranslation[]
  CertificateSkill  CertificateSkill[]
  ServiceSkill      ServiceSkill[]
  CvExperienceSkill CvExperienceSkill[]

  @@unique([userId, title])
}

model SkillTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime    @default(now())
  description   String
  urlWiki       String
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  Skill         Skill?      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId       String?     @db.ObjectId
  appLanguageId String      @db.ObjectId
}

model Certification {
  id                       String                     @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String?                    @db.ObjectId
  user                     User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime                   @default(now())
  company                  String
  issuedDate               Int?
  url                      String?
  idCredential             String?
  image                    String?
  type                     StackType[]
  CertificateSkill         CertificateSkill[]
  CertificationTranslation CertificationTranslation[]
  CertificateProject       CertificateProject[]
  CertificateService       CertificateService[]
}

model CertificationTranslation {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime             @default(now())
  title              String
  language           AppLanguage          @relation(fields: [appLanguageId], references: [id])
  Certification      Certification?       @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId    String?              @db.ObjectId
  appLanguageId      String               @db.ObjectId
  CertificateService CertificateService[]
}

//an certificate can validate multiple skills
//an skill can be validated by multiple certificates
model CertificateSkill {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime      @default(now())
  Certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  Skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  certificationId String        @db.ObjectId
  skillId         String        @db.ObjectId
}

//an certificate can validate multiple projects
//an project can be validated by multiple certificates
model CertificateProject {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime      @default(now())
  Certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  Project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  certificationId String        @db.ObjectId
  projectId       String        @db.ObjectId
}

model ServiceSkill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  Service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  Skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  serviceId String   @db.ObjectId
  skillId   String   @db.ObjectId

  @@unique([serviceId, skillId])
}

//an certificate can validate multiple services
//an service can be validated by multiple certificates
model CertificateService {
  id                         String                    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                  DateTime                  @default(now())
  Certification              Certification             @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  Service                    Service                   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  certificationId            String                    @db.ObjectId
  serviceId                  String                    @db.ObjectId
  CertificationTranslation   CertificationTranslation? @relation(fields: [certificationTranslationId], references: [id], onDelete: Cascade)
  certificationTranslationId String?                   @db.ObjectId
}

enum StackType {
  FRONTEND
  BACKEND
  MOBILE
  DESKTOP
  CYBERSECURITY
  DEVOPS
  SOFTSKILLS
  TOOLS
}

model TimelineItem {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  userId       String           @db.ObjectId
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        Json
  description  Json
  category     TimelineCategory
  organization String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean          @default(false)
  order        Int              @default(0)
  images       String[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

enum TimelineCategory {
  WORK
  STUDY
  COURSE
}

enum SoftSkillsMediaType {
  VIDEO
  IMAGE
}

model PortfolioSoftSkill {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon        String
  title       Json
  description Json
  isVisible   Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, order])
}

model SoftSkillsSection {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String              @unique @db.ObjectId
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType SoftSkillsMediaType @default(VIDEO)
  videoUrl  String?
  posterUrl String?
  imageUrl  String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// ============================================================================
// SPOTIFY OAUTH (per-user connection for Now Playing widget)
// ============================================================================

model SpotifyConnection {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String
  clientSecretEnc    String
  refreshTokenEnc    String
  scope              String?
  connectedAt        DateTime  @default(now())
  lastRefreshErrorAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SpotifyOAuthState {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  state           String   @unique
  userId          String   @db.ObjectId
  clientId        String
  clientSecretEnc String
  codeVerifier    String
  locale          String   @default("en")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}
