model Company {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?
  website     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]
}

model Application {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  position    String
  description String?
  companyId   String   @db.ObjectId
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status      String   // "APPLIED" | "INTERVIEW" | "OFFER" | "GHOSTED" | "REJECTED" | "HIRED"
  appliedDate DateTime
  notes       String?
  salary      String?
  location    String?
  coverLetterSubject String?
  coverLetterBody    String?
  ghostNudgeSnoozedUntil DateTime?
  
  // cvFile embedded as a composite type
  cvFile      CvFile?

  resumeExports ResumeExport[]
  interviewPrepQuestions InterviewPrepQuestion[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  events      ApplicationEvent[]
  documents   Document[]
}

type CvFile {
  name       String
  url        String
  uploadedAt DateTime
}

model ApplicationEvent {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String   @db.ObjectId
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String   // "INTERVIEW" | "TECHNICAL_TEST" | "QUESTIONNAIRE" | "PHONE_CALL" | "MEETING" | "FOLLOW_UP"
  title         String
  description   String?
  scheduledDate DateTime
  duration      Int?     // in minutes
  location      String?
  isVirtual     Boolean?
  meetingLink   String?
  notes         String?
  completed     Boolean  @default(false)
  completedAt   DateTime?
  outcome       String?  // "POSITIVE" | "NEGATIVE" | "NEUTRAL"
  /// Google Calendar event id when synced (BYO OAuth connection).
  googleEventId   String?
  googleEtag      String?
  googleSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  interviewPrepQuestions InterviewPrepQuestion[]
}

model Document {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          String
  url           String
  applicationId String   @db.ObjectId
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedAt    DateTime @default(now())
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewPrepQuestion {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId  String   @db.ObjectId
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  eventId        String   @db.ObjectId
  event          ApplicationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  category       String
  question       String
  whyTheyAsk     String
  modelAnswer    String
  talkingPoints  String[]
  evidenceFromCv String[]
  avoid          String[]
  locale         String
  provider       String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([eventId, createdAt])
  @@index([applicationId])
  @@index([userId, createdAt])
}
