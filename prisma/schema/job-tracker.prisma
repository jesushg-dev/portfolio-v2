model Company {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?
  website     String?
  linkedinUrl String?
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]
}

enum JobSearchStatus {
  OPEN
  CLOSED
}

enum JobSearchOutcome {
  HIRED
  PAUSED
  WITHDRAWN
}

model JobSearch {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  startedAt          DateTime      @default(now())
  endedAt            DateTime?
  status             JobSearchStatus @default(OPEN)
  outcome            JobSearchOutcome?
  hiredApplicationId String?       @db.ObjectId
  notes              String?
  userId             String        @db.ObjectId
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications       Application[]

  @@index([userId, status])
}

model Application {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  position               String
  description            String?
  companyId              String    @db.ObjectId
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobSearchId            String?   @db.ObjectId
  jobSearch              JobSearch? @relation(fields: [jobSearchId], references: [id], onDelete: SetNull)
  status                 String // "APPLIED" | "INTERVIEW" | "OFFER" | "GHOSTED" | "REJECTED" | "HIRED"
  appliedDate            DateTime
  notes                  String?
  salary                 String?
  location               String?
  jobUrl                 String?
  coverLetterSubject     String?
  coverLetterBody        String?
  ghostNudgeSnoozedUntil DateTime?

  // cvFile embedded as a composite type
  cvFile CvFile?

  resumeExports          ResumeExport[]
  interviewPrepQuestions InterviewPrepQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  events    ApplicationEvent[]
  documents Document[]
  emails    ApplicationEmail[]

  @@index([userId, jobSearchId])
}

type CvFile {
  name       String
  url        String
  uploadedAt DateTime
}

model ApplicationEvent {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId  String      @db.ObjectId
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type           String // "INTERVIEW" | "TECHNICAL_TEST" | "QUESTIONNAIRE" | "PHONE_CALL" | "MEETING" | "FOLLOW_UP"
  title          String
  description    String?
  scheduledDate  DateTime
  duration       Int? // in minutes
  location       String?
  isVirtual      Boolean?
  meetingLink    String?
  notes          String?
  completed      Boolean     @default(false)
  completedAt    DateTime?
  outcome        String? // "POSITIVE" | "NEGATIVE" | "NEUTRAL"
  /// Google Calendar event id when synced (BYO OAuth connection).
  googleEventId  String?
  googleEtag     String?
  googleSyncedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userId         String      @db.ObjectId
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  interviewPrepQuestions InterviewPrepQuestion[]
}

model Document {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          String
  url           String
  applicationId String      @db.ObjectId
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedAt    DateTime    @default(now())
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewPrepQuestion {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String      @db.ObjectId
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  eventId String           @db.ObjectId
  event   ApplicationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  category       String
  question       String
  whyTheyAsk     String
  modelAnswer    String
  talkingPoints  String[]
  evidenceFromCv String[]
  avoid          String[]
  locale         String
  provider       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, createdAt])
  @@index([applicationId])
  @@index([userId, createdAt])
}

model ApplicationEmail {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  applicationId     String      @db.ObjectId
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId            String      @db.ObjectId
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail    String
  subject           String
  attachmentName    String
  trackingEnabled   Boolean     @default(false)
  providerMessageId String?
  trackingSource    String?
  recipientKind     String?
  deliveryStatus    String?
  deliveredAt       DateTime?
  deliveryUpdatedAt DateTime?
  openCount         Int         @default(0)
  firstOpenedAt     DateTime?
  lastOpenedAt      DateTime?
  idempotencyKey    String      @unique
  sentAt            DateTime?
  createdAt         DateTime    @default(now())

  opens ApplicationEmailOpen[]

  @@index([applicationId, sentAt])
  @@index([userId, applicationId])
  @@index([providerMessageId])
}

model ApplicationEmailEvent {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  emailId         String   @db.ObjectId
  providerEventId String
  providerMessageId String
  type            String
  occurredAt      DateTime
  receivedAt      DateTime @default(now())

  @@unique([userId, providerEventId])
  @@index([emailId, occurredAt])
}

model ApplicationEmailOpen {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  emailId   String           @db.ObjectId
  email     ApplicationEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  openedAt  DateTime         @default(now())
  userAgent String?
  ipAddress String?

  @@index([emailId, openedAt])
}
