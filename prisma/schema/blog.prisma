// ============================================================================
// BLOG (per-user, multi-locale, normalized series)
// ============================================================================

model BlogSeries {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                  @db.ObjectId
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String
  coverImage   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  posts        BlogPost[]
  translations BlogSeriesTranslation[]

  @@unique([userId, slug])
  @@index([userId])
}

model BlogSeriesTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  seriesId      String      @db.ObjectId
  series        BlogSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  appLanguageId String      @db.ObjectId
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  title         String
  description   String?

  @@unique([seriesId, appLanguageId])
}

model BlogPost {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  userId       String                @db.ObjectId
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String
  coverImage   String?
  tags         String[]              @default([])
  seriesId     String?               @db.ObjectId
  series       BlogSeries?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesOrder  Int?
  status       BlogPostStatus        @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  translations BlogPostTranslation[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([userId, seriesId, seriesOrder])
}

model BlogPostTranslation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  postId        String      @db.ObjectId
  post          BlogPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  appLanguageId String      @db.ObjectId
  language      AppLanguage @relation(fields: [appLanguageId], references: [id])
  title         String
  excerpt       String?
  content       String      @default("")

  @@unique([postId, appLanguageId])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
